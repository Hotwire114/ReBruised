// App icon for BlackAndBruised.exe and BlackAndBruisedLauncher.exe. GLFW_ICON: GLFW (raylib) also uses it for the window.
GLFW_ICON ICON "launcher/assets/rebruised.ico"


// UTF-8 code page + long paths (rebruised.manifest); 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
1 24 "rebruised.manifest"
